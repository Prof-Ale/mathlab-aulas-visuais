{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathlab:portfolio:v1",
  "title": "MathLab — Configuração do portfólio v1",
  "description": "Escolhas editoriais sobre o diário: período, seções, privacidade e a voz do professor. O conteúdo factual vem do diário; aqui só entra o que o professor escreve.",
  "type": "object",
  "required": ["schema_versao", "titulo", "destinatario", "periodos_ids", "privacidade"],
  "additionalProperties": false,
  "properties": {
    "schema_versao": { "const": "portfolio.1" },
    "titulo": { "type": "string", "minLength": 3 },
    "subtitulo": { "type": "string" },
    "destinatario": { "enum": ["direcao", "coordenacao", "autoavaliacao"] },
    "periodos_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "turmas_ids": { "type": "array", "items": { "type": "string" } },
    "secoes": {
      "type": "array",
      "items": { "enum": ["matriz_cobertura", "linha_do_periodo", "destaques", "avaliacoes", "evolucao", "reflexao"] },
      "default": ["matriz_cobertura", "linha_do_periodo", "destaques", "avaliacoes", "evolucao", "reflexao"]
    },
    "privacidade": {
      "type": "object",
      "required": ["exigir_rostos_borrados"],
      "additionalProperties": false,
      "properties": {
        "exigir_rostos_borrados": {
          "type": "boolean",
          "description": "true: foto com rosto só entra se os rostos estiverem borrados, mesmo havendo autorização registrada."
        }
      }
    },
    "apresentacao": { "type": "string", "maxLength": 1200 },
    "reflexao_geral": { "type": "string", "maxLength": 2000 },
    "proximos_passos": { "type": "array", "items": { "type": "string" } }
  }
}
